# Copy to your environment (never commit real keys).
# Optional: without a key the app still works with rule-based answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
# Total seconds an AI answer may take before the rule-based fallback is used
GEMINI_TIMEOUT_SECONDS=20
# Optional: live monitoring-station readings (free token: https://aqicn.org/data-platform/token/)
WAQI_TOKEN=
# Optional: persistent community reports (Vercel → Storage → Upstash Redis sets these automatically)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: secret key for hashing voter IPs (derived from the secrets above when unset)
VOTER_SALT=
# Only needed when the frontend runs on a different origin (Vite dev server)
ALLOWED_ORIGINS=http://localhost:5173
