# Copy to your environment (never commit real keys).
# Optional: without a key the app still works with rule-based answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
# Only needed when the frontend runs on a different origin (Vite dev server)
ALLOWED_ORIGINS=http://localhost:5173
